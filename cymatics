    const X=stripP[s].x,Y=stripP[s].y,ox=s*SW;
    if(g<=1.2){
      for(let i=0;i<N;i++){const o=(Y[i]*(SW-2)|0)*TW+ox+(X[i]*(SW-2)|0);sbuf[o]=fg;sbuf[o+1]=fg;sbuf[o+TW]=fg;if(g>.8){sbuf[o-1]=fg;sbuf[o+TW+1]=fg}}
    }else{
      for(let i=0;i<N;i++){
        const cx=ox+(X[i]*(SW-2)|0),cy=Y[i]*(SW-2)|0;
        for(let dy=-r;dy<=r;dy++){const yy=cy+dy;if(yy<0||yy>=SW)continue;
          for(let dx=-r;dx<=r;dx++){if(dx*dx+dy*dy>r*r)continue;const xx=cx+dx;if(xx<ox||xx>=ox+SW)continue;sbuf[yy*TW+xx]=fg}}
      }
    }
  }
  x.putImageData(stripImg,0,0);
}
function setSheet(open){$('sheet').hidden=!open;$('dlsvg').disabled=!!(open&&stripData);stripSoon()}
const tfmt=t=>Math.floor(t/60)+':'+String(Math.floor(t%60)).padStart(2,'0');
async function loadSong(file){
  if(!file)return;const dt=$('dtxt');dt.textContent='Reading '+file.name+'…';
  try{
    const buf=await file.arrayBuffer(),AC=window.AudioContext||window.webkitAudioContext,ac2=new AC();
    const audio=await new Promise((res,rej)=>{const p=ac2.decodeAudioData(buf,res,rej);if(p&&p.then)p.then(res,rej)});
    ac2.close&&ac2.close();dt.textContent='Analysing…';await new Promise(r=>setTimeout(r,30));
    stripData=analyse(audio);stripName=file.name.replace(/\.[^.]+$/,'');
    $('sname').textContent=stripName+' · '+tfmt(audio.duration);
    $('caps').innerHTML=stripData.segs.map(g=>'<div><b>'+tfmt(g.t0)+'–'+tfmt(g.t1)+'</b>'+(g.dom?g.dom+' Hz':'quiet')+'</div>').join('');
    ['stripwrap','caps','stripbtns'].forEach(id=>$(id).hidden=false);
    dt.textContent='Choose another song';initStrip();$('dlsvg').disabled=true;
  }catch(err){dt.textContent='Couldn’t read that file. Try MP3, WAV, M4A or OGG.'}
}
$('songbtn').onclick=()=>setSheet(true);
$('sx').onclick=()=>setSheet(false);
$('file').onchange=e=>{loadSong(e.target.files[0]);e.target.value=''};
const dz=$('drop');
['dragenter','dragover'].forEach(t=>dz.addEventListener(t,e=>{e.preventDefault();dz.classList.add('over')}));
['dragleave','drop'].forEach(t=>dz.addEventListener(t,e=>{e.preventDefault();dz.classList.remove('over')}));
dz.addEventListener('drop',e=>loadSong(e.dataTransfer.files[0]));
$('stripdl').onclick=()=>$('strip').toBlob(b=>saveBlob(b,'cymatics-strip-'+stripName+'.png'));
document.addEventListener('keydown',e=>{if(e.key==='Escape')setSheet(false)});
$('dlsvg').onclick=exportSVG;
$('dl').onclick=()=>(stripActive()?$('strip'):cv).toBlob(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);
  a.download='cymatics-'+S.tn+'-'+S.tm+'.png';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1000)});
document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.tabs button').forEach(x=>x.setAttribute('aria-selected',x===b));S.view=b.dataset.v});
function loop(){
  S.n+=(S.tn-S.n)*.08;S.m+=(S.tm-S.m)*.08;
  if(Math.abs(S.tn-S.n)<.002)S.n=S.tn;if(Math.abs(S.tm-S.m)<.002)S.m=S.tm;
  if(stripActive())drawStrip();else S.view==='sand'?drawSand():S.view==='ascii'?drawAscii():drawField();
  requestAnimationFrame(loop);
}
function fills(){document.querySelectorAll('input[type=range]:not(.hue)').forEach(el=>el.style.setProperty('--p',(el.value-el.min)/(el.max-el.min)*100+'%'))}
document.querySelectorAll('input[type=range]').forEach(el=>el.addEventListener('input',fills));
sync();fills();loop();
</script>
